diff --git a/apps/login/src/lib/saml.test.ts b/apps/login/src/lib/saml.test.ts
new file mode 100644
index 0000000..d8e342e
--- /dev/null
+++ b/apps/login/src/lib/saml.test.ts
@@ -0,0 +1,152 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { loginWithSAMLAndSession } from "./saml";
+import * as sessionModule from "./session";
+import * as zitadelModule from "./zitadel";
+
+vi.mock("./session");
+vi.mock("./zitadel");
+vi.mock("./server/loginname");
+vi.mock("@/lib/grpc/interceptors/error-classification", () => ({
+  isClassifiedError: (error: unknown): boolean =>
+    typeof error === "object" && error !== null && "code" in error && typeof (error as any).code === "number",
+}));
+
+vi.mock("@zitadel/client", () => ({
+  Code: { FailedPrecondition: 9, NotFound: 5 },
+  ConnectError: class MockConnectError extends Error {
+    code: number;
+    constructor(msg: string, code: number) {
+      super(msg);
+      this.code = code;
+    }
+  },
+  create: vi.fn((_schema, value) => value),
+}));
+
+describe("loginWithSAMLAndSession", () => {
+  const mockServiceUrl = "https://zitadel.example.com";
+  const mockSamlRequest = "saml-123";
+  const mockSessionId = "session-123";
+
+  let mockSessions: any[];
+  let mockCookies: any[];
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    vi.spyOn(console, "log").mockImplementation(() => {});
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+
+    mockSessions = [
+      {
+        id: mockSessionId,
+        factors: {
+          user: {
+            id: "user-123",
+            loginName: "test@example.com",
+            organizationId: "org-123",
+          },
+          password: {
+            verifiedAt: { seconds: BigInt(Math.floor(Date.now() / 1000)) },
+          },
+        },
+      },
+    ];
+
+    mockCookies = [
+      {
+        id: mockSessionId,
+        token: "token-123",
+        loginName: "test@example.com",
+        creationTs: new Date().toISOString(),
+        expirationTs: new Date(Date.now() + 3600000).toISOString(),
+        changeTs: new Date().toISOString(),
+      },
+    ];
+  });
+
+  it("should redirect to the SAML response URL when session is valid", async () => {
+    vi.mocked(sessionModule.isSessionValid).mockResolvedValue(true);
+    vi.mocked(zitadelModule.createResponse).mockResolvedValue({
+      url: "https://sp.example.com/acs",
+      binding: { case: "redirect", value: {} },
+    } as any);
+
+    const result = await loginWithSAMLAndSession({
+      serviceUrl: mockServiceUrl,
+      samlRequest: mockSamlRequest,
+      sessionId: mockSessionId,
+      sessions: mockSessions,
+      sessionCookies: mockCookies,
+    } as any);
+
+    expect(result).toEqual({ redirect: "https://sp.example.com/acs" });
+  });
+
+  it("should redirect to /signedin when error code 9 (already handled) and no default URI", async () => {
+    const { ConnectError } = await import("@zitadel/client");
+    vi.mocked(sessionModule.isSessionValid).mockResolvedValue(true);
+    vi.mocked(zitadelModule.createResponse).mockRejectedValue(new ConnectError("already handled", 9));
+    vi.mocked(zitadelModule.getLoginSettings).mockResolvedValue({} as any);
+
+    const result = await loginWithSAMLAndSession({
+      serviceUrl: mockServiceUrl,
+      samlRequest: mockSamlRequest,
+      sessionId: mockSessionId,
+      sessions: mockSessions,
+      sessionCookies: mockCookies,
+    } as any);
+
+    expect(result).toHaveProperty("redirect");
+    if ("redirect" in result) {
+      expect(result.redirect).toContain("/signedin");
+    }
+  });
+
+  // zeroroot-ai/hosted#196: the SAML request no longer exists (the Zitadel
+  // instance that issued it is gone). createResponse answers not_found, and
+  // the fix must route that case to a fresh sign-in, not "Unknown error
+  // occurred".
+  it("should redirect to a fresh sign-in when the SAML request no longer exists (NotFound)", async () => {
+    const { ConnectError } = await import("@zitadel/client");
+    vi.mocked(sessionModule.isSessionValid).mockResolvedValue(true);
+    vi.mocked(zitadelModule.createResponse).mockRejectedValue(
+      new ConnectError("Auth Request does not exist (COMMAND-jae5P)", 5),
+    );
+
+    const result = await loginWithSAMLAndSession({
+      serviceUrl: mockServiceUrl,
+      samlRequest: mockSamlRequest,
+      sessionId: mockSessionId,
+      sessions: mockSessions,
+      sessionCookies: mockCookies,
+    } as any);
+
+    expect(result).toHaveProperty("redirect");
+    if ("redirect" in result) {
+      expect(result.redirect).toContain("/loginname");
+      expect(result.redirect).toContain("requestExpired=true");
+      expect(result.redirect).toContain("loginName=test%40example.com");
+      expect(result.redirect).toContain("organization=org-123");
+    }
+    expect(zitadelModule.getLoginSettings).not.toHaveBeenCalled();
+  });
+
+  it("should return unknown error for non-classified, non-NotFound errors", async () => {
+    vi.mocked(sessionModule.isSessionValid).mockResolvedValue(true);
+    vi.mocked(zitadelModule.createResponse).mockRejectedValue({
+      code: 13,
+      message: "Internal error",
+    });
+
+    const result = await loginWithSAMLAndSession({
+      serviceUrl: mockServiceUrl,
+      samlRequest: mockSamlRequest,
+      sessionId: mockSessionId,
+      sessions: mockSessions,
+      sessionCookies: mockCookies,
+    } as any);
+
+    expect(result).toEqual({ error: "Unknown error occurred" });
+  });
+});
