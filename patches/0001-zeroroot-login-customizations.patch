-export function BackButton() {
+// zeroroot fork patch (deploy#888): optional `href`. When a caller passes an
+// href (e.g. the loginname entry page, whose browser-history "back" lands on a
+// meaningless OIDC redirect), the button navigates to that external origin via a
+// full page load instead of router.back(). Default (no href) is byte-for-byte
+// upstream behavior, so every other call site is unaffected and the rebase onto
+// the next Zitadel login tag stays mechanical.
+export function BackButton({ href, ...props }: { href?: string } & Partial<ButtonProps>) {
